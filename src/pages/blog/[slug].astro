---
import { render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { getPosts, formatDate } from '../../data/blog'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)
const published = post.data.date.toISOString()

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: published,
  url: new URL(Astro.url.pathname, Astro.site).href,
  author: { '@id': 'https://dylan-sanders.com/#person' },
}).replace(/</g, '\\u003c')
---

<Base
  title={`${post.data.title} | Dylan Sanders`}
  description={post.data.description}
  ogType="article"
>
  <meta slot="head" property="article:published_time" content={published} />
  <script slot="head" type="application/ld+json" set:html={jsonLd} />
  <article class="py-20 px-4 sm:px-6 lg:px-8 max-w-3xl mx-auto w-full">
    <a
      href="/blog/"
      class="font-mono text-sm text-slate-500 dark:text-graphite hover:text-ochre dark:hover:text-amber transition-colors"
    >
      &lt;- /blog
    </a>
    <header class="mt-8 mb-10">
      <time datetime={published} class="font-mono text-sm text-ochre dark:text-amber">
        {formatDate(post.data.date)}
      </time>
      <h1 class="mt-2 font-mono text-3xl sm:text-4xl font-bold text-slate-900 dark:text-slate-100 tracking-tight">
        {post.data.title}
      </h1>
      <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">{post.data.description}</p>
    </header>
    <div class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-mono prose-headings:tracking-tight prose-a:text-ochre dark:prose-a:text-amber prose-code:before:content-none prose-code:after:content-none">
      <Content />
    </div>
  </article>
</Base>
