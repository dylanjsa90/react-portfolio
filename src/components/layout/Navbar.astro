---
import ThemeToggle from '../ui/ThemeToggle.astro'

interface Props {
  name: string
  navLinks: string[]
}

const { name, navLinks } = Astro.props
---

<header class="sticky top-0 z-50 bg-paper/80 dark:bg-ink/80 backdrop-blur-sm border-b border-line dark:border-line-dark">
  <nav class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-14">
    <a
      href="/#"
      class="font-mono font-semibold text-slate-900 dark:text-slate-100 hover:text-ochre dark:hover:text-amber transition-colors"
    >
      {name.toLowerCase().replace(/\s+/g, '-')}
    </a>
    <div class="flex items-center gap-1">
      <ul class="hidden sm:flex items-center gap-1">
        {navLinks.map(link => (
          <li>
            <a
              href={`/#${link}`}
              class="px-3 py-1.5 font-mono text-sm text-slate-600 dark:text-slate-400 hover:text-ochre dark:hover:text-amber transition-colors"
            >
              /{link}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
      <button
        type="button"
        id="menu-button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        class="sm:hidden p-2 rounded-sm text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100 hover:bg-line/50 dark:hover:bg-panel transition-colors"
      >
        <svg
          data-icon="close"
          xmlns="http://www.w3.org/2000/svg"
          class="hidden h-5 w-5"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M5.47 5.47a.75.75 0 011.06 0L12 10.94l5.47-5.47a.75.75 0 111.06 1.06L13.06 12l5.47 5.47a.75.75 0 11-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 01-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 010-1.06z"
            clip-rule="evenodd"
          ></path>
        </svg>
        <svg
          data-icon="open"
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M3 6.75A.75.75 0 013.75 6h16.5a.75.75 0 010 1.5H3.75A.75.75 0 013 6.75zM3 12a.75.75 0 01.75-.75h16.5a.75.75 0 010 1.5H3.75A.75.75 0 013 12zm0 5.25a.75.75 0 01.75-.75h16.5a.75.75 0 010 1.5H3.75a.75.75 0 01-.75-.75z"
            clip-rule="evenodd"
          ></path>
        </svg>
      </button>
    </div>
  </nav>
  <ul
    id="mobile-menu"
    class="hidden sm:hidden border-t border-line dark:border-line-dark px-4 pt-2 pb-3 space-y-1"
  >
    {navLinks.map(link => (
      <li>
        <a
          href={`/#${link}`}
          class="block px-3 py-2 font-mono text-sm text-slate-600 dark:text-slate-400 hover:text-ochre dark:hover:text-amber transition-colors"
        >
          /{link}
        </a>
      </li>
    ))}
  </ul>
</header>

<script>
  import { initMobileMenu } from '../../scripts/menu'
  initMobileMenu()
</script>
