---
import type { Job } from '../../types'

interface Props extends Job {
  isLast: boolean
}

const { role, company, period, bullets, isLast } = Astro.props
---

<div class="flex flex-col sm:flex-row gap-2 sm:gap-6">
  <span class="font-mono text-sm text-slate-500 dark:text-graphite sm:w-28 shrink-0 sm:text-right sm:pt-0.5">
    {period}
  </span>
  <div class:list={['border-l border-line dark:border-line-dark pl-6', isLast ? 'pb-0' : 'pb-10']}>
    <div class="mb-2">
      <span class="font-mono font-semibold text-slate-900 dark:text-slate-100">{role}</span>
      <span class="text-slate-500 dark:text-slate-400">{` · ${company}`}</span>
    </div>
    <ul class="space-y-1">
      {bullets.map(b => (
        <li class="text-sm text-slate-600 dark:text-slate-400 flex gap-2">
          <span class="font-mono text-ochre dark:text-amber">+</span>
          {b}
        </li>
      ))}
    </ul>
  </div>
</div>
