---
import SectionWrapper from '../ui/SectionWrapper.astro'
import type { AboutData } from '../../types'

type Props = AboutData

const { bio, highlights } = Astro.props
---

<SectionWrapper id="about" title="About Me">
  <div class="grid md:grid-cols-2 gap-10 items-start">
    <p class="text-slate-600 dark:text-slate-400 leading-relaxed text-lg">{bio}</p>
    <ul class="space-y-3">
      {highlights.map(h => (
        <li class="flex items-start gap-3 text-slate-700 dark:text-slate-300">
          <span class="font-mono text-ochre dark:text-amber shrink-0">+</span>
          {h}
        </li>
      ))}
    </ul>
  </div>
</SectionWrapper>
